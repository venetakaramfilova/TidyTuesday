```{r}

historic_station_met <- 
  read_csv('https://raw.githubusercontent.com/rfordatascience/tidytuesday/main/data/2025/2025-10-21/historic_station_met.csv')
station_meta <- 
  read_csv('https://raw.githubusercontent.com/rfordatascience/tidytuesday/main/data/2025/2025-10-21/station_meta.csv')

```

Max values for all years 2000 - 2024 | orderd by values in 2015

```{r}
met_station_data_max_2000 <-
  historic_station_met |>
  left_join(station_meta, by = "station") |>
  select(-station) |>
  filter(year > 1999) |>
  group_by(station_name, year) |>
  summarise(
    max_temp = max(tmax, na.rm = TRUE),
    min_temp = min(tmin, na.rm = TRUE), 
    max_sun = max(sun, na.rm = TRUE), 
    max_rain = max(rain, na.rm = TRUE),
    .groups = "drop"
  ) |>
  group_by(station_name) |>
  filter(n() == 25) |> 
  ungroup() |>
  left_join(
    historic_station_met |> 
      filter(year == 2015) |> 
      group_by(station) |> 
      summarise(max_rain_2015 = max(rain, na.rm = TRUE), .groups = "drop") |> 
      left_join(station_meta, by = "station") |> 
      select(station_name, max_rain_2015),
    by = "station_name"
  ) |>
  mutate(station_name = fct_reorder(station_name, max_rain_2015, .desc = FALSE)) |>
  select(-max_rain_2015)

```

Rain by Year

```{r}
plot <- 
  ggplot(
    met_station_data_max_2000, 
    aes(x = year, y = station_name, fill = max_rain)
  ) +
    geom_tile(color = "white", linewidth = 0.3, na.rm = TRUE) +
    scale_x_continuous(breaks = c(2000, 2005, 2010, 2015, 2020, 2024)) +
    scale_fill_paletteer_c("grDevices::Blues", direction = -1, na.value = "transparent") +
    labs(
      title = "Rainfall Across UK Stations",
      subtitle = str_wrap(
        "In 2015, Eskdalemuir recorded more than 500 mm of rain, the highest value for a single month, while more than half of the other stations recorded under 200 mm."
      ),
      caption = str_wrap(
        "Source: UK Met Office, data curated by Jack Davison | Viz: Veneta Karamfilova"
      ),
      fill = "Rain (mm)", 
      x = "", 
      y = ""
    ) +
    theme_minimal() +
    theme(
      panel.grid.major = element_blank(),
      panel.grid.minor = element_blank(),
      panel.grid.major.x = element_blank(),
      panel.grid.major.y = element_blank(),
      axis.text.y = element_text(hjust = 1),
      axis.text.x = element_text(angle = 45, hjust = 1),
      plot.title = element_text(
        color = "gray30",
        size = 16,
        face = "bold",
        hjust = -0.12,
        margin = margin(t = 10, b = 10)
      ),
      plot.subtitle = element_text(
        color = "gray40",
        size = 12,
        hjust = -0.23,
        margin = margin(b = 10)
    ),
      plot.caption = element_text(
        color = "gray50", 
        size = 10, 
        hjust = 1.3,
        margin = margin(t = 10)
      ),
      plot.margin = margin(t = 10, r = 20, b = 10, l = 20),
      legend.position = "left",
      axis.text.y.right = element_text(hjust = 0),
      axis.title.y.right = element_text(hjust = 0)
    ) +
    scale_y_discrete(position = "right")

  ggsave("Rainfall.png", plot, width = 12, height = 10, dpi = 300)

```
